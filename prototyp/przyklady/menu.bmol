# Interaktywne menu: keyInput wczytuje liczby i tekst z klawiatury

MAIN BEGIN
    imie as text
    keyInput("Jak masz na imię? ", REF imie)
    println("Cześć, ", imie, "! (", imie.length, " B)")

    dane as pointer
    dane.new[8]
    wybor as byte = 0

    repeat
        println("")
        println("1 - zmień rozmiar bloku   2 - wypełnij bajtem   3 - pokaż blok   0 - koniec")
        keyInput("Wybór: ", REF wybor)
        if wybor == 1 then
            rozmiar as unsigned_32
            keyInput("Nowy rozmiar w bajtach: ", REF rozmiar)
            dane.update[rozmiar]
            println("Blok ma teraz ", dane.size, " B")
        elseif wybor == 2 then
            wartosc as byte
            keyInput("Bajt (0...255): ", REF wartosc)
            dane.byte.fill[wartosc]
        elseif wybor == 3 then
            println(dane : hex)
        elseif wybor != 0 then
            println("Nie ma takiej opcji")
        if.end
    until wybor == 0

    keyInput("Naciśnij Enter, aby zakończyć...")
MAIN END
