# Pętle z typowanym licznikiem i zamiana typu „as”

MAIN BEGIN
    # licznik zadeklarowany wcześniej zachowuje ostatnią wartość
    i as int
    for i = 1 to 10 step 3 do
        print(i, " ")
    for.end
    println("  →  po pętli i = ", i, "   (oczekiwane 10)")

    # licznik typu byte: cały zakres 0...255 bez przekręcenia
    suma as longint = 0
    for b as byte = 0 to 255 do
        suma += b
    for.end
    println("Suma 0...255 = ", suma, "   (oczekiwane 32640)")

    # pętla w dół
    for k as shortint = 5 to -5 step -5 do
        print(k, " ")
    for.end
    println("")

    # as: najmłodsza część i odcięcie ułamka
    duza as int = 1000
    println("1000 as byte = ", duza as byte, "   (oczekiwane 232)")
    println("-1 as byte = ", -1 as byte, "   (oczekiwane 255)")
    x as doublefloat = 3.99
    println("3.99 as int = ", x as int, "   (oczekiwane 3)")
    println("7 as bit = ", 7 as bit, "   (oczekiwane 1)")
    println("2 + 300 as byte = ", 2 + 300 as byte, "   (as wiąże mocniej niż +: 2 + 44 = 46)")

    # zapis przez soczewkę: o szerokości decyduje as
    blok as pointer
    blok.new[4]
    blok.fill[&AAh]
    for n as int = 0 to 3 do
        blok.byte[n] = (n * 16 + n) as byte
    for.end
    println("Blok:", blok : hex)

    # foreach z typowanym numerem elementu
    foreach px, nr as int in blok.byte do
        px = nr as byte
    foreach.end
    println("Po foreach:", blok : hex)
MAIN END
