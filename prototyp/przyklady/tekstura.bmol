# Test na teksturze: obraz 256 × 256 pikseli Color (10 B na piksel)
# Sprawdza: STRUCT, soczewki, widok prostokątny, kopię prostokąta,
# foreach, operacje blokowe, saturate, funkcje z CONST i REF.

CONST SZER as int = 256
CONST WYS as int = 256

Color as STRUCT { R as unsigned_16, G as unsigned_16, B as unsigned_16, Alpha as unsigned_32 }

GLOBAL obraz as pointer

MAIN BEGIN
    obraz.new[SZER*WYS*Color]
    println("Obraz: ", obraz, "  (oczekiwane 655360 B = 256 × 256 × 10)")

    # gradient: R rośnie w poziomie, G w pionie
    for y as int = 0 to WYS - 1 do
        for x as int = 0 to SZER - 1 do
            n as longint = y * SZER + x
            r as unsigned_16 = x * 256
            g as unsigned_16 = y * 256
            obraz.Color[n].R = r
            obraz.Color[n].G = g
            obraz.Color[n].B = 1000
            obraz.Color[n].Alpha = 65535
        for.end
    for.end

    println("Piksel (100, 50): R = ", obraz.Color[50*SZER + 100].R,
            ", G = ", obraz.Color[50*SZER + 100].G, "   (oczekiwane 25600, 12800)")

    # widok 4 × 2 piksele od (100, 50): bez kopiowania danych
    kafelek as pointer = obraz.viewRectangle[100*Color, 50, 4*Color, 2, SZER*Color]
    println("Kafelek: ", kafelek, "  (oczekiwane 80 B = 4 × 2 × 10)")
    println("Kafelek, pierwszy wiersz (R = 25600 = &6400h):", kafelek.viewPortion[0:20] : hex)

    # kopia tego samego prostokąta
    miniatura as pointer = obraz.copyRectangle[100*Color, 50, 4*Color, 2, SZER*Color]

    # odwrócenie kanału R w kafelku (zmienia oryginalny obraz)
    foreach px in kafelek.Color do
        px.R = 65535 - px.R
    foreach.end
    println("Po odwróceniu R w kafelku: obraz (100, 50).R = ", obraz.Color[50*SZER + 100].R,
            "   (oczekiwane 39935)")
    println("Kopia nietknięta:         miniatura[0].R = ", miniatura.Color[0].R,
            "   (oczekiwane 25600)")

    # nasycenie na bajtach: operacja blokowa na całej kopii
    jasny as pointer = miniatura.copy
    jasny.byte = saturate(jasny.byte + 200)
    print("Bajty miniatury przed: ")
    for k as int = 0 to 9 do print(miniatura.byte[k], " "); for.end
    println("")
    print("Bajty po saturate(+200): ")
    for k as int = 0 to 9 do print(jasny.byte[k], " "); for.end
    println("   (każdy ≤ 255, bez „przekręcenia”)")

    # funkcje: CONST (tylko odczyt) i REF (zmiana zmiennej wywołującego)
    suma as doublefloat = sumaR(kafelek)
    println("Suma R w kafelku: ", suma : 0, "   (oczekiwane 316408 = 2 × (4 × 65535 − 256 × (100+101+102+103)))")
    a as int = 3
    b as int = 7
    zamien(REF a, REF b)
    println("Po zamien(REF a, REF b): a = ", a, ", b = ", b)

    # liczby w zapisie szesnastkowym i binarnym
    v as unsigned_16 = obraz.Color[0].Alpha
    println("Alpha = ", v : hex, " = ", v : bin)

    kafelek.release
    jasny.release
    miniatura.release
    obraz.release
    return 0
MAIN END

FUNCTION sumaR(CONST dane as pointer): doublefloat
    s as doublefloat = 0
    foreach px in dane.Color do
        s = s + px.R
    foreach.end
    return s
sumaR.end

FUNCTION zamien(REF a as int, REF b as int)
    t as int = a; a = b; b = t
zamien.end
