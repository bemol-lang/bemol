# Zasady arytmetyki i soczewek Z1–Z5 (specyfikacja, sekcje 5 i 10)

MAIN BEGIN
    a as byte = 200
    b as byte = 200

    println("--- Z1/Z2: liczymy na stole, worek decyduje przy wrzucaniu")
    maly as byte = a + b
    println("maly = a + b            → ", maly, "   (oczekiwane 144)")
    srednia as byte = (a + b) / 2
    println("srednia = (a + b) / 2   → ", srednia, "   (oczekiwane 200)")
    jest as bit = 0
    if a + b > 255 then jest = 1; if.end
    println("a + b > 255             → ", jest, "   (oczekiwane 1)")
    wynik as int = 7.9 + 0.5
    println("7.9 + 0.5 do int        → ", wynik, "   (oczekiwane 8)")
    f as doublefloat = 7 / 2 + 0.5
    println("7 / 2 + 0.5             → ", f, "   (oczekiwane 4: całe działanie zmiennoprzecinkowe)")
    nas as byte = saturate(a + b)
    println("saturate(a + b) do byte → ", nas, "   (oczekiwane 255)")
    r as byte = &81h
    r2 as byte = r rol 1
    println("&81h rol 1 w bajcie     → ", r2 : hex, "   (oczekiwane &03h)")

    println("--- Z3: soczewka czyta i pisze swoją szerokość")
    blok as pointer
    blok.new[8]
    blok.fill[&FFh]
    blok.byte[5] = 7
    x as int = blok.byte[5]
    println("x as int = blok.byte[5] → ", x, "   (oczekiwane 7, czyta 1 bajt)")
    licznik as int = 300
    blok.byte[2] = licznik
    println("blok.byte[2] = 300      → ", blok.byte[2], "   (oczekiwane 44), sąsiad byte[3] = ", blok.byte[3], " (oczekiwane 255)")
    wiekszy as bit = 0
    if blok.byte[5] > licznik then wiekszy = 1; if.end
    println("blok.byte[5] > 300      → ", wiekszy, "   (oczekiwane 0)")
    blok.byte += 100
    println("blok.byte += 100        →", blok : hex)

    println("--- Z4: .at — dowolny typ od dowolnego bajtu")
    blok.clear
    blok.unsigned_16.at[3] = &ABCDh
    println("unsigned_16.at[3]       →", blok : hex)
    d as doublefloat
    blok.doublefloat.at[0] = 3.25
    d = blok.doublefloat.at[0]
    println("doublefloat.at[0]       → ", d, "   (oczekiwane 3.25)")

    println("--- Z5: literał szesnastkowy i binarny pisze tyle bitów, ile ma zapis")
    blok.fill[&FFh]
    blok.byte[0] = &0000000b
    println("7 bitów zer w &FFh      → ", blok.byte[0] : hex, "   (oczekiwane &80h)")
MAIN END
