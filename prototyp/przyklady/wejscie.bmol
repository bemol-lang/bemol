# INPUT.read: czyta wejście porcjami do bufora, liczy bajty i linie
# Użycie: wejscie < plik.txt

MAIN BEGIN
    bufor as pointer
    bufor.new[16]                  # celowo mały bufor: wiele porcji
    razem as longint = 0
    linie as longint = 0
    porcje as int = 0

    n as longint = INPUT.read[bufor]
    while n > 0 do
        porcje += 1
        razem += n
        for i as longint = 0 to n - 1 do
            if bufor.byte[i] == 10 then
                linie += 1
            if.end
        for.end
        n = INPUT.read[bufor]
    while.end

    println("Bajty: ", razem, ", linie: ", linie, ", porcje po 16 B: ", porcje)
MAIN END
